# CodeIgniter 4 specific ignores
writable/debugbar/
writable/cache/*
!writable/cache/index.html
writable/logs/*
!writable/logs/index.html
writable/session/*
!writable/session/index.html
writable/uploads/*
!writable/uploads/index.html

# Composer dependencies
/vendor/

# Environment files that may contain sensitive data
.env
.env.backup

# OS specific files
.DS_Store
Thumbs.db
desktop.ini

# IDE/Editor folders
.idea/
.vscode/
nbproject/
*.sublime-project
*.sublime-workspace

# Node modules if any
/node_modules/

# Other caches and temporary files
*.log
*.tmp
*.temp
*.cache
*~

# PHP specific caches
opcache/
*.opcache

# System and application caches
cache/
tmp/
temp/