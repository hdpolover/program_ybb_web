#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# CACHE
#--------------------------------------------------------------------

cache.handler = predis
cache.backupHandler = file
cache.prefix = ybb_web_

# Redis Configuration (database 1 reserved for program web app)
cache.redis.host = 127.0.0.1
cache.redis.port = 6379
cache.redis.password =
cache.redis.database = 1
cache.redis.timeout = 0

#--------------------------------------------------------------------
# APP
#---------------------------------------------------------why -----------
app.baseURL = 'http://localhost:8100/'

# Default Web Settings
DEFAULT_SITE_NAME="Japan Youth Summit"
DEFAULT_TAGLINE="Connecting Japanese youth with the world" 
DEFAULT_LOGO_URL="https://japanyouthsummit.com/assets/logo/logo.png"
DEFAULT_LOCATION="Tokyo, Japan"
DEFAULT_ORGANIZER="Youth Break the Boundaries Foundation"

#--------------------------------------------------------------------
# CHAT WIDGET CONFIGURATION
#--------------------------------------------------------------------
CHAT_WIDGET_ENABLED=true
CHAT_WIDGET_URL="https://aksamu.com/chat-widget.js"
CHAT_WIDGET_BOT_ID="4a9ea369-4638-413f-92d4-9c4600f7c6be"
CHAT_WIDGET_PRIMARY_COLOR="#16a34a"
CHAT_WIDGET_BUTTON_SHAPE="circle"